      }
    },
    {
      "name": "Получить список всех компаний",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8080/companies",
          "host": ["http://localhost:8080"],
          "path": ["companies"]
        }
      }
    },
    {
      "name": "Обновить компанию",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Company\",\n  \"budget\": 7000000,\n  \"employeeIds\": [2, 4]\n}"
        },
        "url": {
          "raw": "http://localhost:8080/companies/1",
          "host": ["http://localhost:8080"],
          "path": ["companies", "1"]
