      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Example Company\",\n  \"budget\": 5000000,\n  \"employeeIds\": []\n}"
        },
        "url": {
          "raw": "http://localhost:8080/companies",
          "host": ["localhost"],
          "port": "8080",
          "path": ["companies"]
        }
      }
    },
    {
      "name": "Получить компанию по ID",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
